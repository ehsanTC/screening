<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <DefineConstants>$(DefineConstants);DISABLE_GENERATED_UNHANDLED_EXCEPTION_HANDLER</DefineConstants>
        <BreakOnUnhandledExceptions>true</BreakOnUnhandledExceptions>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="Uno.Extensions.Storage" />
        <PackageReference Include="Uno.WinRT" />
        <PackageReference Include="YamlDotNet"/>

        <EmbeddedResource Include="Assets\en\Diabetes-Type2-questionnaire.yaml"
                          LogicalName="en\Diabetes-Type2-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\en\Baseline.yaml"
                          LogicalName="en\Baseline.yaml"/>

        <EmbeddedResource Include="Assets\en\Ascvd-questionnaire.yaml"
                          LogicalName="en\Ascvd-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\en\Fracture-questionnaire.yaml"
                          LogicalName="en\Fracture-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\en\Obesity-questionnaire.yaml"
                          LogicalName="en\Obesity-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\en\disorder-evaluate-questionnaire.yaml"
                          LogicalName="en\disorder-evaluate-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\en\Liver-questionnaire.yaml"
                          LogicalName="en\Liver-questionnaire.yaml"/>

        <!-- Persian Questionnaires -->
        <EmbeddedResource Include="Assets\fa\Diabetes-Type2-questionnaire.yaml"
                          LogicalName="fa\Diabetes-Type2-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\fa\Baseline.yaml"
                          LogicalName="fa\Baseline.yaml"/>

        <EmbeddedResource Include="Assets\fa\Ascvd-questionnaire.yaml"
                          LogicalName="fa\Ascvd-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\fa\Fracture-questionnaire.yaml"
                          LogicalName="fa\Fracture-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\fa\Obesity-questionnaire.yaml"
                          LogicalName="fa\Obesity-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\fa\disorder-evaluate-questionnaire.yaml"
                          LogicalName="fa\disorder-evaluate-questionnaire.yaml"/>

        <EmbeddedResource Include="Assets\fa\Liver-questionnaire.yaml"
                          LogicalName="fa\Liver-questionnaire.yaml"/>

    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Common\Common.csproj" />
    </ItemGroup>

    <Target Name="ValidateLocalizedAssets" BeforeTargets="BeforeBuild">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\ValidateLocalizedAssets.ps1&quot; -AssetsPath &quot;$(MSBuildProjectDirectory)\Assets&quot;" />
    </Target>
</Project>
