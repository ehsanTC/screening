<ContentDialog
    x:Class="Screening.Presentation.Dialogs.ResultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:Screening.Presentation.Dialogs"
    xmlns:utility="using:Screening.Presentation.Utility"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    BorderThickness="1"
    CornerRadius="16"
    MaxWidth="360"
    HorizontalAlignment="Center">

    <ContentDialog.Resources>
        <dialogs:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ContentDialog.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================= -->
        <!-- Header                        -->
        <!-- ============================= -->
        <Grid Grid.Row="0"
              Padding="16,8,16,16"
              Visibility="{Binding IsAiDescriptionVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock
                Grid.Column="0"
                Text="{Binding Risk.Icon}"
                FontSize="42"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />

            <!-- Title / Subtitle -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding Risk.Title}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Foreground="{Binding Risk.Color}" />

                <TextBlock
                    Text="{Binding Risk.SubTitle}"
                    FontSize="13"
                    Opacity="0.7"
                    Foreground="#808080"
                    TextWrapping="Wrap"
                    Margin="0,4,0,0" />

            </StackPanel>

        </Grid>

        <!-- ============================= -->
        <!-- Expandable Content            -->
        <!-- ============================= -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                CornerRadius="16"
                Visibility="{Binding IsAiDescriptionVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                MaxHeight="500">

                <StackPanel>

                    <!-- ========================= -->
                    <!-- Severity                  -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16">

                                <TextBlock
                                    x:Uid="ResultDialog_Severity"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border
                            Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.RiskDescription}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>

                    <!-- ========================= -->
                    <!-- Description / Summary     -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16">

                                <TextBlock
                                    x:Uid="ResultDialog_Description"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.Summary}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>


                    <!-- ========================= -->
                    <!-- Prevention Steps          -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16">

                                <TextBlock
                                    x:Uid="ResultDialog_PreventionSteps"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                                <StackPanel Spacing="16">

                                    <!-- Primordial -->
                                    <StackPanel
                                        Spacing="8"
                                        Visibility="{Binding Risk.PreventionSteps.Primordial.Count}">

                                        <TextBlock
                                            x:Uid="ResultDialog_PrimordialPrevention"
                                            FontSize="14"
                                            FontWeight="SemiBold" />

                                        <ItemsControl
                                            ItemsSource="{Binding Risk.PreventionSteps.Primordial}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid Margin="0,2,0,2">

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="•"
                                                            FontSize="14"
                                                            Margin="0,0,8,0" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding}"
                                                            FontSize="14"
                                                            TextWrapping="Wrap" />

                                                    </Grid>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>


                                    <!-- Primary -->
                                    <StackPanel Spacing="8">

                                        <TextBlock
                                            x:Uid="ResultDialog_PrimaryPrevention"
                                            FontSize="14"
                                            FontWeight="SemiBold" />

                                        <ItemsControl
                                            ItemsSource="{Binding Risk.PreventionSteps.Primary}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid Margin="0,2,0,2">

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="•"
                                                            FontSize="14"
                                                            Margin="0,0,8,0" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding}"
                                                            FontSize="14"
                                                            TextWrapping="Wrap" />

                                                    </Grid>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>


                                    <!-- Secondary -->
                                    <StackPanel Spacing="8">

                                        <TextBlock
                                            x:Uid="ResultDialog_SecondaryPrevention"
                                            FontSize="14"
                                            FontWeight="SemiBold" />

                                        <ItemsControl
                                            ItemsSource="{Binding Risk.PreventionSteps.Secondary}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Grid Margin="0,2,0,2">

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            Text="•"
                                                            FontSize="14"
                                                            Margin="0,0,8,0" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding}"
                                                            FontSize="14"
                                                            TextWrapping="Wrap" />

                                                    </Grid>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>

                                </StackPanel>

                        </Border>

                    </Expander>

                    <!-- ========================= -->
                    <!-- Next Steps                -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16">

                                <TextBlock
                                    x:Uid="ResultDialog_NextSteps"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.NextSteps}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>


                    <!-- ========================= -->
                    <!-- Follow Up                   -->
                    <!-- ========================= -->

                    <Expander BorderThickness="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16">

                                <TextBlock
                                    x:Uid="ResultDialog_FollowUp"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.FollowUp}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>


                    <!-- ========================= -->
                    <!-- Patient Education           -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16">

                                <TextBlock
                                    x:Uid="ResultDialog_PatientEducation"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.PatientEducation}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>

                </StackPanel>

            </ScrollViewer>

        </Border>

        <!-- AI panel -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                CornerRadius="16"
                Visibility="{Binding IsAiDescriptionVisible, Converter={StaticResource BoolToVisibilityConverter}}">

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                <TextBlock
                    Text="The Ai description is not accessible right now."
                    TextWrapping="Wrap"
                    FontSize="14"
                    Padding="16"
                    utility:BoldMarkdownExtensions.BoldMarkdownText="{Binding AiDescription}"
                    />
            </ScrollViewer>

        </Border>

        <!-- Single toggle button -->
        <Button Grid.Row="2"
                CornerRadius="17"
                FontSize="16"
                Margin="12 24 12 0"
                HorizontalAlignment="Center"
                IsEnabled="{Binding IsAiButtonEnabled, Mode=OneWay}"
                Command="{Binding ToggleAiDescription}">

            <Grid>
                <TextBlock x:Uid="ResultDialog_DescribeWithAi"
                           Visibility="{Binding IsAiDescriptionVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                <TextBlock x:Uid="ResultDialog_ShowResult"
                           Visibility="{Binding IsAiDescriptionVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

        </Button>
    </Grid>

</ContentDialog>
