<ContentDialog
    x:Class="Screening.Presentation.Dialogs.ResultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    BorderThickness="1"
    CornerRadius="16"
    MaxWidth="360"
    HorizontalAlignment="Center">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- ============================= -->
        <!-- Header                         -->
        <!-- ============================= -->

        <Grid Grid.Row="0"
              Padding="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock
                Grid.Column="0"
                Text="{Binding Risk.Icon}"
                FontSize="42"
                VerticalAlignment="Center"
                Margin="0,0,12,0" />

            <!-- Title / Subtitle -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">

                <TextBlock
                    Text="{Binding Risk.Title}"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Foreground="{Binding Risk.Color}"/>

                <TextBlock
                    Text="{Binding Risk.SubTitle}"
                    FontSize="13"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    Margin="0,4,0,0" />

            </StackPanel>

        </Grid>


        <!-- ============================= -->
        <!-- Expandable Content             -->
        <!-- ============================= -->

        <Border Grid.Row="1"
                Background="#FFFFFF"
                CornerRadius="16">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                MaxHeight="500">

                <StackPanel>


                    <!-- ========================= -->
                    <!-- Severity                    -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Severity "
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Risk.Severity}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border
                            Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.Severity}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>


                    <Border Height="1"
                            Background="#DDDDDD"
                            Margin="16,0" />


                    <!-- ========================= -->
                    <!-- Description / Summary       -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Description"
                                    FontSize="15"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch"/>



                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.Summary}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>


                    <Border Height="1"
                            Background="#DDDDDD"
                            Margin="16,0" />


                    <!-- ========================= -->
                    <!-- Prevention Steps            -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Prevention Steps"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="›"
                                    FontSize="24"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.PreventionSteps}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>


                    <Border Height="1"
                            Background="#DDDDDD"
                            Margin="16,0" />


                    <!-- ========================= -->
                    <!-- Next Steps                  -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Next Steps"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="›"
                                    FontSize="24"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.NextSteps}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>


                    <Border Height="1"
                            Background="#DDDDDD"
                            Margin="16,0" />


                    <!-- ========================= -->
                    <!-- Follow Up                   -->
                    <!-- ========================= -->

                    <Expander BorderThickness="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Follow Up"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="›"
                                    FontSize="24"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.FollowUp}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>


                    <Border Height="1"
                            Background="#DDDDDD"
                            Margin="16,0" />


                    <!-- ========================= -->
                    <!-- Patient Education           -->
                    <!-- ========================= -->

                    <Expander
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">

                        <Expander.Header>
                            <Grid Padding="16,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Patient Education"
                                    FontSize="15"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="›"
                                    FontSize="24"
                                    VerticalAlignment="Center" />

                            </Grid>
                        </Expander.Header>

                        <Border Padding="16,0,16,16">

                            <ScrollViewer
                                MaxHeight="300"
                                VerticalScrollBarVisibility="Auto">

                                <TextBlock
                                    Text="{Binding Risk.PatientEducation}"
                                    TextWrapping="Wrap"
                                    FontSize="14" />

                            </ScrollViewer>

                        </Border>

                    </Expander>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</ContentDialog>
