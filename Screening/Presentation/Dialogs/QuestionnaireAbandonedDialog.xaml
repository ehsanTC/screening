<ContentDialog
    x:Class="Screening.Presentation.Dialogs.QuestionnaireAbandonedDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFEFFF"
    PrimaryButtonText="OK"
    SecondaryButtonText="Cancel"
    DefaultButton="Secondary">

    <Border CornerRadius="16"
            Background="{ThemeResource ContentDialogBackground}"
            BorderThickness="1"
            BorderBrush="{ThemeResource ContentDialogBorderBrush}"
            MinHeight="400"
            Width="360"
            Padding="20">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Source="ms-appx:///Assets/questionnaire-abandoned.png"
                   Width="120" Height="120" Stretch="Uniform"
                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="1" Text="Questionnaire Abandoned"
                       FontSize="18" FontWeight="Bold"
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Do you want to leave without finishing?"
                       FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</ContentDialog>

