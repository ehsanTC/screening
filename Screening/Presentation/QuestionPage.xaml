<Page x:Class="Screening.Presentation.QuestionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:presentation="using:Screening.Presentation"
      xmlns:views="using:Screening.Presentation.Views">

    <Page.Resources>
        <DataTemplate x:Key="TextInputQuestionTemplate">
            <views:TextInputQuestionView />
        </DataTemplate>

        <DataTemplate x:Key="SingleChoiceQuestionTemplate">
            <views:SingleChoiceQuestionView />
        </DataTemplate>

        <DataTemplate x:Key="MultiChoiceQuestionTemplate">
            <views:MultiChoiceQuestionView />
        </DataTemplate>

        <DataTemplate x:Key="RepeatableKeyValueQuestionTemplate">
            <views:RepeatableKeyValueQuestionView />
        </DataTemplate>

        <presentation:QuestionTemplateSelector x:Key="QuestionTemplateSelector"
               TextInputTemplate="{StaticResource TextInputQuestionTemplate}"
               SingleChoiceTemplate="{StaticResource SingleChoiceQuestionTemplate}"
               MultiChoiceTemplate="{StaticResource MultiChoiceQuestionTemplate}"
               RepeatableKeyValueTemplate="{StaticResource RepeatableKeyValueQuestionTemplate}" />
    </Page.Resources>

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Nav bar -->
            <RowDefinition Height="Auto" />   <!-- Progress bar -->
            <RowDefinition />                 <!-- Question content -->
            <RowDefinition Height="Auto" />   <!-- Nav buttons -->
        </Grid.RowDefinitions>

        <utu:NavigationBar Content="Diabetes Type 2" />

        <!-- Progress of question -->
        <views:QuestionnaireProgressView
            Grid.Row="1"
            DataContext="{Binding State.Progression, Mode=OneWay}" />

        <!-- Main Question Area -->
        <ContentControl Grid.Row="2"
                        Content="{Binding State.CurrentQuestion, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource QuestionTemplateSelector}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />

        <!-- Navigation Buttons -->
        <Grid Grid.Row="3"
              Margin="16"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Uid="QuestionPage_BackButton"
                    CornerRadius="17"
                    Height="60"
                    FontSize="16"
                    HorizontalAlignment="Stretch"
                    FontFamily="ms-appx:///Assets/Fonts/YEKANBAKHFANUM-SEMIBOLD.TTF#YEKANBAKHFANUM"
                    IsEnabled="{Binding State.CanGoBack, Mode=OneWay}"
                    Command="{Binding Back}" />

            <Button Grid.Column="1"
                    Content="{Binding State.NextButtonText, Mode=OneWay}"
                    CornerRadius="17"
                    Height="60"
                    FontSize="16"
                    FontFamily="ms-appx:///Assets/Fonts/YEKANBAKHFANUM-SEMIBOLD.TTF#YEKANBAKHFANUM"
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding State.CanGoNext, Mode=OneWay}"
                    Command="{Binding Next}" />
        </Grid>

        <Border x:Name="ValidationToast"
                Grid.RowSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="16,16,16,84"
                Padding="16,12"
                CornerRadius="8"
                Background="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="Collapsed">
            <TextBlock x:Name="ValidationToastText"
                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
