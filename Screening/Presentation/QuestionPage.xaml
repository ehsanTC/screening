<Page x:Class="Screening.Presentation.QuestionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:presentation="using:Screening.Presentation"
      xmlns:views1="clr-namespace:Screening.Presentation.Views">

    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <utu:NavigationBar Content="Diabetes Type 2" />

        <!-- Main Question Area -->
        <!-- The custom views like TextInputQuestionView or SingleChoiceQuestionView or MultiChoiceQuestionView should be placed here based on a criteria -->


        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="16">

            <Button Content="Back"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding State.CanGoBack, Mode=OneWay}"
                    Command="{Binding Back}" />

            <Button Content="Next"
                    IsEnabled="{Binding State.CanGoNext, Mode=OneWay}"
                    Click="OnNextClicked" />

        </StackPanel>

        <Border x:Name="ValidationToast"
                Grid.RowSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="16,16,16,84"
                Padding="16,12"
                CornerRadius="8"
                Background="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="Collapsed">
            <TextBlock x:Name="ValidationToastText"
                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Page>
