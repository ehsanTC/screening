<Page x:Class="Screening.Presentation.QuestionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:views="using:Screening.Presentation.QuestionViews"
      xmlns:presentation="clr-namespace:Screening.Presentation"
      xmlns:views1="clr-namespace:Screening.Presentation.Views"
      Background="{ThemeResource BackgroundBrush}">

    <Page.Resources>
        <!-- Question Template Selector -->
        <presentation:QuestionTemplateSelector x:Key="QuestionTemplateSelector">
            <presentation:QuestionTemplateSelector.TextInputTemplate>
                <DataTemplate>
                    <views1:TextInputQuestionView />
                </DataTemplate>
            </presentation:QuestionTemplateSelector.TextInputTemplate>

            <!-- Add more templates in future -->
            <!--
            <views:QuestionTemplateSelector.PhotoTemplate>
                <DataTemplate>
                    <views:PhotoQuestionView />
                </DataTemplate>
            </views:QuestionTemplateSelector.PhotoTemplate>
            -->
        </presentation:QuestionTemplateSelector>
    </Page.Resources>


    <Grid utu:SafeArea.Insets="VisibleBounds">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <utu:NavigationBar Content="Questions" />

        <!-- Question Content -->
        <ContentControl Grid.Row="1"
                        Content="{Binding CurrentQuestion}"
                        ContentTemplateSelector="{StaticResource QuestionTemplateSelector}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Margin="16" />

        <!-- Navigation Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="16">

            <Button Content="Back"
                    Margin="0,0,8,0"
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding CanGoBack}" />

            <Button Content="Next"
                    Command="{Binding NextCommand}"
                    IsEnabled="{Binding CanGoNext}" />
        </StackPanel>
    </Grid>
</Page>


