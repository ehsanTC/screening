<Page x:Class="Screening.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:views="using:Screening.Presentation.Views"
      NavigationCacheMode="Required"
      Background="{StaticResource AppPageBackgroundBrush}">

    <Grid
        VerticalAlignment="Top"
        ColumnSpacing="8"
        utu:SafeArea.Insets="VisibleBounds">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <utu:NavigationBar Grid.Row="0"
            Content="{Binding Title}" />

        <Border
            Grid.Row="1" CornerRadius="16"
            Background="{ThemeResource PrimaryColor}"
            Height="80"
            Margin="20">

            <TextBlock Grid.Row="1" Text="Select a Questionnaire"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center"
                       Padding="12"
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2"
            VerticalAlignment="Top"
            ColumnSpacing="8"
            Margin="8"
            utu:SafeArea.Insets="VisibleBounds">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:DisorderCardView
                Grid.Column="0"
                BottomLabelText="8 Questions"
                BottomLabelFontSize="12"
                BottomLabelFontFamily="Arial"
                BottomLabelForeground="#4A5568"
                MainLabelText="Diabetes"
                MainLabelFontSize="14"
                MainLabelFontFamily="Arial"
                MainLabelForeground="#1A202C"
                ImageSource="ms-appx:///Assets/Icons/diabetes.png"
                ImageWidth="56"
                ImageHeight="56"
                ImageStretch="Uniform"
                Command="{Binding GoToDiabetesQuestionnaire}" />

            <views:DisorderCardView
                Grid.Column="1"
                MainLabelText="Heart"
                BottomLabelText="10 Questions"
                BottomLabelFontSize="12"
                BottomLabelFontFamily="Arial"
                BottomLabelForeground="#4A5568"
                MainLabelFontSize="14"
                MainLabelFontFamily="Arial"
                MainLabelForeground="#1A202C"
                ImageSource="ms-appx:///Assets/Icons/cardiovascular.png"
                ImageWidth="56"
                ImageHeight="56"
                ImageStretch="Uniform"
                Command="{Binding GoToAscdv}" />

            <views:DisorderCardView
                Grid.Column="2"
                MainLabelText="Fracture"
                BottomLabelText="6 Questions"
                BottomLabelFontSize="12"
                BottomLabelFontFamily="Arial"
                BottomLabelForeground="#4A5568"
                MainLabelFontSize="14"
                MainLabelFontFamily="Arial"
                MainLabelForeground="#1A202C"
                ImageSource="ms-appx:///Assets/Icons/fracture.png"
                ImageWidth="56"
                ImageHeight="56"
                ImageStretch="Uniform"
                Command="{Binding GoToFracture}" />

        </Grid>
    </Grid>
</Page>
