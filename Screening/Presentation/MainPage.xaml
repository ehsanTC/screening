<Page x:Class="Screening.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:views="using:Screening.Presentation.Views"
      NavigationCacheMode="Required"
      Background="{StaticResource AppPageBackgroundBrush}">

    <Grid
        ColumnSpacing="8"
        utu:SafeArea.Insets="VisibleBounds">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <utu:NavigationBar Grid.Row="0"
                           Content="{Binding Title}" />

        <Border Grid.Row="1"
                CornerRadius="16"
                Background="{ThemeResource PrimaryColor}"
                Height="80"
                Margin="20">

            <Grid>
                <!-- Shadow copy -->
                <TextBlock x:Uid="SelectQuestionnaireTextBlock"
                           Foreground="#878787"
                           Opacity="50"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="12"
                           TextWrapping="Wrap">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="2" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Real text on top -->
                <TextBlock x:Uid="SelectQuestionnaireTextBlock"
                           Foreground="#FFFFFF"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Padding="12"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>


        <Grid Grid.Row="2"
              VerticalAlignment="Top"
              ColumnSpacing="8"
              RowSpacing="8"
              Margin="8"
              utu:SafeArea.Insets="VisibleBounds">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <views:DisorderCardView
                Grid.Column="0"
                Grid.Row="0"
                x:Uid="DiabetesCard"
                BottomLabelFontSize="12"
                BottomLabelFontFamily="Arial"
                BottomLabelForeground="#4A5568"
                MainLabelFontSize="14"
                MainLabelFontFamily="Arial"
                MainLabelForeground="#1A202C"
                ImageSource="ms-appx:///Assets/Icons/diabetes.png"
                ImageWidth="56"
                ImageHeight="56"
                ImageStretch="Uniform"
                Command="{Binding GoToDiabetes}" />

            <views:DisorderCardView
                Grid.Column="1"
                Grid.Row="0"
                x:Uid="HeartCard"
                BottomLabelFontSize="12"
                BottomLabelFontFamily="Arial"
                BottomLabelForeground="#4A5568"
                MainLabelFontSize="14"
                MainLabelFontFamily="Arial"
                MainLabelForeground="#1A202C"
                ImageSource="ms-appx:///Assets/Icons/cardiovascular.png"
                ImageWidth="56"
                ImageHeight="56"
                ImageStretch="Uniform"
                Command="{Binding GoToAscvd}" />

            <views:DisorderCardView
                Grid.Column="2"
                Grid.Row="0"
                MainLabelText="Fracture"
                BottomLabelFontSize="12"
                BottomLabelFontFamily="Arial"
                BottomLabelForeground="#4A5568"
                MainLabelFontSize="14"
                MainLabelFontFamily="Arial"
                MainLabelForeground="#1A202C"
                ImageSource="ms-appx:///Assets/Icons/fracture.png"
                ImageWidth="56"
                ImageHeight="56"
                ImageStretch="Uniform"
                Command="{Binding GoToFracture}" />

            <views:DisorderCardView
                Grid.Column="0"
                Grid.Row="1"
                MainLabelText="Obesity"
                BottomLabelText="7 Questions"
                BottomLabelFontSize="12"
                BottomLabelFontFamily="Arial"
                BottomLabelForeground="#4A5568"
                MainLabelFontSize="14"
                MainLabelFontFamily="Arial"
                MainLabelForeground="#1A202C"
                ImageSource="ms-appx:///Assets/Icons/obesity.png"
                ImageWidth="56"
                ImageHeight="56"
                ImageStretch="Uniform"
                Command="{Binding GoToObesity}" />

            <views:DisorderCardView
                Grid.Column="1"
                Grid.Row="1"
                MainLabelText="Fatty Liver"
                BottomLabelText="5 Questions"
                BottomLabelFontSize="12"
                BottomLabelFontFamily="Arial"
                BottomLabelForeground="#4A5568"
                MainLabelFontSize="14"
                MainLabelFontFamily="Arial"
                MainLabelForeground="#1A202C"
                ImageSource="ms-appx:///Assets/Icons/liver.png"
                ImageWidth="56"
                ImageHeight="56"
                ImageStretch="Uniform"
                Command="{Binding GoToLiver}"/>

        </Grid>

        <Button Grid.Row="3"
                CornerRadius="17"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="20, 0, 20, 0"
                Style="{StaticResource OptionButtonButtonStyle}"
                Command="{Binding GoToGeneralEvaluation}">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center">
                <TextBlock Text="Health with Ai"
                           FontSize="16"
                           VerticalAlignment="Center" />
                <Image Source="/Assets/Images/bot-head-doctor.png"
                       Width= "35"
                       Height="35"
                       VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>
