<UserControl
    x:Class="Screening.Presentation.Views.DisorderCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root"
    Width="103"
    Height="140">

    <Grid
        DataContext="{Binding ElementName=Root}">
        <!-- Lower Gray Square -->
        <Border
            Width="103"
            Height="110"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,24,0,0"
            CornerRadius="22"
            Background="#E5E7ED">

            <TextBlock
                Text="{Binding BottomLabelText}"
                FontSize="{Binding BottomLabelFontSize}"
                FontFamily="{Binding BottomLabelFontFamily}"
                Foreground="{Binding BottomLabelForeground}"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0, 0, 0, 5"/>
        </Border>

        <!-- Upper White Square with Image -->
        <Border
            Width="103"
            Height="110"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            CornerRadius="22"
            Background="#FFFFFF">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="0"
                    Source="{Binding ImageSource}"
                    Width="{Binding ImageWidth}"
                    Height="{Binding ImageHeight}"
                    Stretch="{Binding ImageStretch}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <TextBlock
                    Grid.Row="1"
                    Text="{Binding MainLabelText}"
                    FontSize="{Binding MainLabelFontSize}"
                    FontFamily="{Binding MainLabelFontFamily}"
                    FontWeight="Bold"
                    Foreground="{Binding MainLabelForeground}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="4,0,4,8"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Tap target stretched over the whole card -->
        <Button
            Command="{Binding Command}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#FFFFFF"
            BorderBrush="#FFFFFF"
            BorderThickness="0"
            Padding="0">
            <Button.Template>
                <ControlTemplate>
                    <ContentPresenter />
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</UserControl>
