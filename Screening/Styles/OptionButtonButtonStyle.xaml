<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/YEKANBAKHFANUM-SEMIBOLD.TTF#YEKANBAKHFANUM</FontFamily>

    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#6C55FF" />

        <Style x:Key="OptionButtonButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource OptionForeground}" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            CornerRadius="15"
                            Background="{StaticResource OptionCheckedBackground}"
                            BorderThickness="2"
                            BorderBrush="{StaticResource OptionCheckedBorder}"
                            Padding="16,12">
                        <ContentPresenter x:Name="ContentHost"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.BorderThickness" Value="3" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.BorderThickness" Value="3" />
                                        <Setter Target="RootBorder.Background" Value="{StaticResource ButtonPressedBackground}" />
                                        <Setter Target="RootBorder.BorderBrush" Value="{StaticResource OptionCheckedBorder}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootBorder.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
