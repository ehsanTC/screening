<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Uno.Toolkit.UI;assembly=Uno.Toolkit.WinUI">

    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="#F2F4F7" />

    <Style TargetType="Page">
        <Setter Property="Background"
                Value="{StaticResource AppPageBackgroundBrush}" />
    </Style>

    <Style TargetType="ui:NavigationBar">
        <Setter Property="Background" Value="{StaticResource AppPageBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AppPageBackgroundBrush}" />
    </Style>

</ResourceDictionary>
