<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0-android;net9.0-ios;net9.0</TargetFrameworks>
        <DefineConstants>$(DefineConstants);DISABLE_GENERATED_UNHANDLED_EXCEPTION_HANDLER</DefineConstants>
        <BreakOnUnhandledExceptions>true</BreakOnUnhandledExceptions>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Display name -->
        <ApplicationTitle>Screening</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>ir.DiseaseScreening</ApplicationId>
        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <!-- Package Publisher -->
        <ApplicationPublisher>O=Screening</ApplicationPublisher>
        <!-- Package Description -->
        <Description>Screening powered by Uno Platform.</Description>

        <!--
          UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
          https://aka.platform.uno/singleproject-features
        -->
        <UnoFeatures>
            Material;
            Dsp;
            Hosting;
            Toolkit;
            Logging;
            MVUX;
            Configuration;
            HttpRefit;
            Serialization;
            Localization;
            Navigation;
            ThemeService;
            SkiaRenderer;
        </UnoFeatures>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\Icons\logo.png" />
    </ItemGroup>

    <ItemGroup>
        <UnoSplashScreen Include="Assets\Icons\logo.png"
                         BaseSize="128,128"
                         Color="#512BD4" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Screening.Domain\Screening.Domain.csproj" />
    </ItemGroup>
</Project>
