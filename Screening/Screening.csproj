<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0-android;net9.0-ios;net9.0</TargetFrameworks>
        <DefineConstants>$(DefineConstants);DISABLE_GENERATED_UNHANDLED_EXCEPTION_HANDLER</DefineConstants>
        <BreakOnUnhandledExceptions>true</BreakOnUnhandledExceptions>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Display name -->
        <ApplicationTitle>Screening</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>ir.DiseaseScreening</ApplicationId>
        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <!-- Package Publisher -->
        <ApplicationPublisher>O=Screening</ApplicationPublisher>

        <!--
          UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
          https://aka.platform.uno/singleproject-features
        -->
        <UnoFeatures>
            Material;
            Dsp;
            Hosting;
            Toolkit;
            Logging;
            MVUX;
            Configuration;
            HttpRefit;
            Serialization;
            Localization;
            Navigation;
            Storage;
            ThemeService;
            SkiaRenderer;
        </UnoFeatures>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Assets\Icons\logo.png" />
        <Content Include="Assets\Icons\cardiovascular.png" />
        <Content Include="Assets\Icons\diabetes.png" />
        <Content Include="Assets\Icons\fracture.png" />
        <Content Include="Assets\Icons\liver.png" />
        <Content Include="Assets\Icons\obesity.png" />
        <Content Include="Assets\Images\questionnaire-finished.png" />
        <Content Include="Assets\Images\questionnaire-abandoned.png" />

        <EmbeddedResource Include="Assets\Prompts\en\AssessmentExplainPrompt.txt"
                          LogicalName="en\AssessmentExplainPrompt.txt"/>
        <EmbeddedResource Include="Assets\Prompts\fa\AssessmentExplainPrompt.txt"
                          LogicalName="fa\AssessmentExplainPrompt.txt"/>

        <EmbeddedResource Include="Assets\AiCredentials.json"
                          LogicalName="AiCredentials.json" />
    </ItemGroup>

    <ItemGroup>
        <UnoSplashScreen Include="Assets\Icons\logo.png"
                         BaseSize="128,128"
                         Color="#512BD4" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Common\Common.csproj" />
      <ProjectReference Include="..\Screening.Domain\Screening.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Assets\Icons\" />
      <Folder Include="Assets\Images\" />
      <Folder Include="Assets\Prompts\en\" />
      <Folder Include="Assets\Prompts\fa\" />
      <Folder Include="Platforms\Android\Assets\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Uno.CommunityToolkit.WinUI.UI.Controls.Markdown" />
    </ItemGroup>
</Project>
